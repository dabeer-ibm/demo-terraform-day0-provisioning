# restrict-region.sentinel
#
# Enforcement: advisory (warns but never blocks).
# Flags any workload tagged with a region outside the preferred list.

import "tfplan/v2" as tfplan

allowed_regions = ["us-east-1", "eu-west-1", "ap-south-1"]

workload_changes = filter tfplan.resource_changes as _, rc {
	rc.type is "docker_container" and
	rc.mode is "managed" and
	(rc.change.actions contains "create" or rc.change.actions contains "update")
}

violations = filter workload_changes as _, rc {
	any rc.change.after.labels as l {
		l.label is "region" and l.value not in allowed_regions
	}
}

for violations as addr, rc {
	print("⚠", addr, "uses a non-preferred region")
}

main = rule {
	length(violations) is 0
}
